APP_NAME=VideoWalker
APP_VERSION=1.0.0
DEBUG=False

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=videowalker
DB_CHARSET=utf8mb4

# YOLO detector
YOLO_API_URL=http://localhost:9000/infer
YOLO_API_KEY=
YOLO_TIMEOUT=20
# Optional for YOLO service process
YOLO_MODELS_DIR=./backend/yolo_service/models

# Video
VIDEO_FRAME_INTERVAL=30
FRAME_INTERVAL=30
FRAME_STORAGE_PATH=./storage/frames
RTSP_TRANSPORT=tcp
RTSP_TIMEOUT=10

# Concurrency
MAX_CONCURRENT_CAMERAS=10
MAX_CONCURRENT_DETECTIONS=5
ALERT_DEDUP_SECONDS=300
QUEUE_WORKER_COUNT=3
TASK_MAX_RETRIES=2
TASK_POLL_INTERVAL_SECONDS=0.5

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/videowalker.log

# CORS
CORS_ORIGINS=["http://localhost:80","http://localhost:3000","http://127.0.0.1:80","http://127.0.0.1:3000"]

# CMS (optional)
CMS_BASE_URL=http://10.1.1.1:8031
CMS_USERNAME=admin
CMS_PASSWORD=123456
CMS_TOKEN=
CMS_TIMEOUT=30
